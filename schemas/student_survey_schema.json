{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "模拟学生问卷结构",
  "type": "object",
  "required": ["research_id", "synthetic_flag", "synthetic_version", "recent_research_task", "ai_used", "recent_task_type", "task_participation_stages", "ai_evidence_checked", "ai_evidence_objects", "ai_evidence_methods", "method_decision_actions", "info_source_check_actions", "training_need"],
  "properties": {
    "research_id": {"type": "string", "nullable": false, "description_zh": "模拟去标识化研究编号；不含真实身份映射", "synthetic_only": true},
    "synthetic_flag": {"type": "string", "nullable": false, "enum": ["TRUE"], "allowed_values": ["TRUE"], "description_zh": "模拟记录标志", "synthetic_only": true},
    "synthetic_version": {"type": "string", "nullable": false, "enum": ["phase2b_v06_contract_v2"], "allowed_values": ["phase2b_v06_contract_v2"], "description_zh": "流程模拟版本标记", "synthetic_only": true},
    "recent_research_task": {"type": "string", "nullable": false, "enum": ["YES", "NO", "UNSURE", "NA_REFUSE"], "allowed_values": ["YES", "NO", "UNSURE", "NA_REFUSE"], "description_zh": "Q1：过去12个月内是否有符合定义的研究型学习任务；是否作为入组门槛待导师确认", "synthetic_only": true},
    "ai_used": {"type": "string", "nullable": false, "enum": ["YES", "NO", "UNSURE", "NO_TOOL", "NA_APPL", "NA_REFUSE", "NA_SKIP"], "allowed_values": ["YES", "NO", "UNSURE", "NO_TOOL", "NA_APPL", "NA_REFUSE", "NA_SKIP"], "description_zh": "Q7：最近任务中的生成式AI使用；Q1非YES时跳过并记NA_SKIP", "synthetic_only": true},
    "ai_stage_problem": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q8现有粗分阶段字段；非AI使用时结构跳过", "synthetic_only": true},
    "ai_stage_information": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q8信息类合并字段；不能区分线索检索与整理解释", "synthetic_only": true},
    "ai_stage_method": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q8方法比较粗分字段", "synthetic_only": true},
    "ai_stage_limitation": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "模拟保留的扩展字段；Q8无直接对应选项，不可解释为Q8测量", "synthetic_only": true},
    "ai_reason_check": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q9：是否追问理由或条件", "synthetic_only": true},
    "ai_evidence_checked": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NO_RELEVANT_OUTPUT", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NO_RELEVANT_OUTPUT", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q10：是否进行核查；拒答与漏答分开，无相关输出不等同于未核查", "synthetic_only": true},
    "ai_evidence_objects": {"type": "string", "nullable": false, "pattern": "^(?:(?:SOURCE_EXISTS|CLAIM_SUPPORT|DATE_SCOPE|POPULATION_MEASURE|DATA_CALCULATION|CROSS_SOURCE|OTHER)(?:\\|(?:SOURCE_EXISTS|CLAIM_SUPPORT|DATE_SCOPE|POPULATION_MEASURE|DATA_CALCULATION|CROSS_SOURCE|OTHER))*|NA_DK|NA_REFUSE|NA_MISS|NA_SKIP)$", "description_zh": "Q10a：核查对象类别多选或单独缺失码；Q10未答YES时结构性跳过", "synthetic_only": true},
    "ai_evidence_methods": {"type": "string", "nullable": false, "pattern": "^(?:(?:OPEN_ORIGINAL|SEARCH_INDEPENDENT|COMPARE_TEXT|RECALCULATE|CONSULT_QUALIFIED_PERSON|OTHER)(?:\\|(?:OPEN_ORIGINAL|SEARCH_INDEPENDENT|COMPARE_TEXT|RECALCULATE|CONSULT_QUALIFIED_PERSON|OTHER))*|NA_DK|NA_REFUSE|NA_MISS|NA_SKIP)$", "description_zh": "Q10b：核查方式类别多选或单独缺失码；Q10未答YES时结构性跳过", "synthetic_only": true},
    "ai_output_handling": {"type": "string", "nullable": false, "enum": ["ACCEPT", "ACCEPT_AFTER_CHECK", "MODIFY", "PARTIAL", "REFERENCE_ONLY", "REJECT", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["ACCEPT", "ACCEPT_AFTER_CHECK", "MODIFY", "PARTIAL", "REFERENCE_ONLY", "REJECT", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q11：AI输出处理方式", "synthetic_only": true},
    "ai_disagreement_response": {"type": "string", "nullable": false, "enum": ["COMPARE_BASIS", "ASK_AGAIN", "ASK_PERSON", "ACCEPT_AI", "KEEP_ORIGINAL", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["COMPARE_BASIS", "ASK_AGAIN", "ASK_PERSON", "ACCEPT_AI", "KEEP_ORIGINAL", "NOT_ENCOUNTERED", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q12：AI建议与原判断不一致时的处理方式", "synthetic_only": true},
    "ai_method_compare": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q14：Q7=使用过时单独询问是否要求AI比较方法，与本人是否作出方法选择无关", "synthetic_only": true},
    "method_choice_occurred": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "最近任务是否出现方法选择环节；漏答与拒答分开", "synthetic_only": true},
    "method_decision_actions": {"type": "string", "nullable": false, "pattern": "^(?:(?:UNDERSTOOD_PURPOSE|MATCHED_TO_QUESTION|CONSIDERED_DATA|CHANGED_OR_REJECTED|MADE_FINAL_CHOICE|OTHER)(?:\\|(?:UNDERSTOOD_PURPOSE|MATCHED_TO_QUESTION|CONSIDERED_DATA|CHANGED_OR_REJECTED|MADE_FINAL_CHOICE|OTHER))*|NA_DK|NA_REFUSE|NA_MISS|NA_SKIP)$", "description_zh": "Q14：本人理解、适配和选择方法的行为多选或单独缺失码；仅方法选择=是时作答", "synthetic_only": true},
    "info_source_check_actions": {"type": "string", "nullable": false, "pattern": "^(?:(?:OPEN_ORIGINAL|SEARCH_INDEPENDENT|COMPARE_SOURCES|CHECK_DATE|CHECK_METHOD|ASK_PERSON)(?:\\|(?:OPEN_ORIGINAL|SEARCH_INDEPENDENT|COMPARE_SOURCES|CHECK_DATE|CHECK_METHOD|ASK_PERSON))*|NO_SPECIAL_CHECK|NO_RELATED_EXPERIENCE|NA_DK|NA_REFUSE|NA_MISS)$", "description_zh": "Q13：一般信息判断多选行为；无特别核查、无相关经历、未知、拒答、漏答分别编码且互斥", "synthetic_only": true},
    "a9_first_action": {"type": "string", "nullable": false, "enum": ["CHECK_DEFINITION", "SEEK_OTHER_EVIDENCE", "DIRECT_EFFECT_CLAIM", "GENERALIZE_TO_ALL", "NA_DK", "NA_REFUSE", "NA_MISS"], "allowed_values": ["CHECK_DEFINITION", "SEEK_OTHER_EVIDENCE", "DIRECT_EFFECT_CLAIM", "GENERALIZE_TO_ALL", "NA_DK", "NA_REFUSE", "NA_MISS"], "description_zh": "Q18情境题四种实质策略及缺失状态", "synthetic_only": true},
    "a9_reason": {"type": "string", "nullable": false, "description_zh": "A9策略理由；仅模拟文本", "synthetic_only": true},
    "recent_task_type": {"type": "string", "nullable": false, "enum": ["COURSE_RESEARCH", "COURSE_SURVEY_REPORT", "INNOVATION_PROJECT", "COMPETITION_RESEARCH", "MENTOR_PROJECT", "OTHER_RESEARCH_TASK", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["COURSE_RESEARCH", "COURSE_SURVEY_REPORT", "INNOVATION_PROJECT", "COMPETITION_RESEARCH", "MENTOR_PROJECT", "OTHER_RESEARCH_TASK", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q2：最近任务类型；未知、拒答、漏答分开；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "task_participation_stages": {"type": "string", "nullable": false, "pattern": "^(?:(?:DEFINE_QUESTION|FIND_OR_EVALUATE_SOURCES|EVALUATE_INFORMATION|CHOOSE_OR_MODIFY_METHOD|COLLECT_OR_ORGANIZE_DATA|ANALYZE_DATA|INTERPRET_OR_LIMIT_CONCLUSION|WRITE_OR_PRESENT|OTHER)(?:\\|(?:DEFINE_QUESTION|FIND_OR_EVALUATE_SOURCES|EVALUATE_INFORMATION|CHOOSE_OR_MODIFY_METHOD|COLLECT_OR_ORGANIZE_DATA|ANALYZE_DATA|INTERPRET_OR_LIMIT_CONCLUSION|WRITE_OR_PRESENT|OTHER))*|NA_DK|NA_REFUSE|NA_MISS|NA_SKIP)$", "description_zh": "Q3：最近任务实际参与环节；去重多选或独立缺失码；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "method_training": {"type": "string", "nullable": false, "pattern": "^(?:(?:COURSE|WORKSHOP|GUIDED_TASK|SELF_STUDY)(?:\\|(?:COURSE|WORKSHOP|GUIDED_TASK|SELF_STUDY))*|NONE|NA_DK|NA_REFUSE|NA_MISS)$", "description_zh": "Q6：研究方法/资料评价/数据分析训练经历；支持去重多选，尚未接触和缺失状态互斥", "synthetic_only": true},
    "major_group": {"type": "string", "nullable": false, "enum": ["ECONOMICS", "PUBLIC_FINANCE", "FINANCE_INSURANCE", "STATISTICS_DATA", "ACCOUNTING_AUDIT", "BUSINESS_MANAGEMENT", "TRADE_LOGISTICS", "OTHER_FINANCE_RELATED", "NA_DK", "NA_REFUSE", "NA_MISS"], "allowed_values": ["ECONOMICS", "PUBLIC_FINANCE", "FINANCE_INSURANCE", "STATISTICS_DATA", "ACCOUNTING_AUDIT", "BUSINESS_MANAGEMENT", "TRADE_LOGISTICS", "OTHER_FINANCE_RELATED", "NA_DK", "NA_REFUSE", "NA_MISS"], "description_zh": "Q4财经专业大类候选，分类边界仍待导师核定", "synthetic_only": true},
    "year_of_study": {"type": "string", "nullable": false, "enum": ["YEAR_1", "YEAR_2", "YEAR_3", "YEAR_4", "NA_REFUSE", "NA_MISS"], "allowed_values": ["YEAR_1", "YEAR_2", "YEAR_3", "YEAR_4", "NA_REFUSE", "NA_MISS"], "description_zh": "Q5本科年级", "synthetic_only": true},
    "school_type": {"type": "string", "nullable": false, "description_zh": "学校类型粗分类", "synthetic_only": true},
    "guidance_context": {"type": "string", "nullable": false, "description_zh": "近期任务中的主要支持来源；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "training_need": {"type": "string", "nullable": false, "pattern": "^(?:(?:RESEARCH_QUESTION|SOURCE_EVALUATION|AI_CHECKING|METHOD_SELECTION|SURVEY_SAMPLING|DATA_ANALYSIS|LIMITATION_INTERPRETATION|ACADEMIC_INTEGRITY|MENTOR_FEEDBACK)(?:\\|(?:RESEARCH_QUESTION|SOURCE_EVALUATION|AI_CHECKING|METHOD_SELECTION|SURVEY_SAMPLING|DATA_ANALYSIS|LIMITATION_INTERPRETATION|ACADEMIC_INTEGRITY|MENTOR_FEEDBACK)){0,2}|NO_ADDITIONAL_NEED|NA_DK|NA_REFUSE|NA_MISS)$", "description_zh": "Q16：研究训练与培养需求；最多三项，互斥状态单独保存且全体展示", "synthetic_only": true},
    "policy_awareness": {"type": "string", "nullable": false, "enum": ["RULES_CLEAR_BOUNDARIES", "RULES_UNSPECIFIC", "INCONSISTENT", "NOT_HEARD", "NA_DK", "NA_REFUSE", "NA_MISS"], "allowed_values": ["RULES_CLEAR_BOUNDARIES", "RULES_UNSPECIFIC", "INCONSISTENT", "NOT_HEARD", "NA_DK", "NA_REFUSE", "NA_MISS"], "description_zh": "Q17 OPTIONAL：对课程/项目生成式AI规则说明情况的模拟编码", "synthetic_only": true},
    "open_concern": {"type": "string", "nullable": false, "description_zh": "Q19 OPTIONAL：模拟文本或NO_RELATED_VIEW/缺失状态；不得包含真实个人信息", "synthetic_only": true},
    "unverified_acceptance": {"type": "string", "nullable": false, "description_zh": "未核验采纳行为自报", "synthetic_only": true},
    "info_confidence_optional": {"type": "string", "nullable": false, "enum": ["1", "2", "3", "4", "5", "NA_DK", "NA_REFUSE", "NA_MISS"], "allowed_values": ["1", "2", "3", "4", "5", "NA_DK", "NA_REFUSE", "NA_MISS"], "description_zh": "Q20 OPTIONAL：信息判断自我感知，不作能力分数", "synthetic_only": true}
  },
  "additionalProperties": true
}
