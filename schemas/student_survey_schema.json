{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "模拟学生问卷结构",
  "type": "object",
  "required": ["research_id", "synthetic_flag", "synthetic_version", "recent_research_task", "ai_used", "recent_task_type", "task_participation_stages", "ai_evidence_checked", "ai_evidence_objects", "ai_evidence_methods", "method_decision_actions", "info_source_check_actions", "training_need"],
  "properties": {
    "research_id": {"type": "string", "nullable": false, "description_zh": "模拟去标识化研究编号；不含真实身份映射", "synthetic_only": true},
    "synthetic_flag": {"type": "string", "nullable": false, "enum": ["TRUE"], "allowed_values": ["TRUE"], "description_zh": "模拟记录标志", "synthetic_only": true},
    "synthetic_version": {"type": "string", "nullable": false, "enum": ["phase2b_v06_contract_v1"], "allowed_values": ["phase2b_v06_contract_v1"], "description_zh": "流程模拟版本标记", "synthetic_only": true},
    "recent_research_task": {"type": "string", "nullable": false, "enum": ["YES", "NO", "UNSURE", "NA_REFUSE"], "allowed_values": ["YES", "NO", "UNSURE", "NA_REFUSE"], "description_zh": "Q1：过去12个月内是否有符合定义的研究型学习任务；是否作为入组门槛待导师确认", "synthetic_only": true},
    "ai_used": {"type": "string", "nullable": false, "enum": ["YES", "NO", "UNSURE", "NO_TOOL", "NA_APPL", "NA_REFUSE", "NA_SKIP"], "allowed_values": ["YES", "NO", "UNSURE", "NO_TOOL", "NA_APPL", "NA_REFUSE", "NA_SKIP"], "description_zh": "Q7：最近任务中的生成式AI使用；Q1非YES时跳过并记NA_SKIP", "synthetic_only": true},
    "ai_stage_problem": {"type": "string", "nullable": false, "description_zh": "AI用于问题界定阶段；未使用时题面固定项为NOT_USED，不确定时题目显示并允许NA_DK", "synthetic_only": true},
    "ai_stage_information": {"type": "string", "nullable": false, "description_zh": "AI用于信息判断阶段", "synthetic_only": true},
    "ai_stage_method": {"type": "string", "nullable": false, "description_zh": "AI用于方法比较阶段", "synthetic_only": true},
    "ai_stage_limitation": {"type": "string", "nullable": false, "description_zh": "AI用于限制分析阶段", "synthetic_only": true},
    "ai_reason_check": {"type": "string", "nullable": false, "description_zh": "追问理由或条件", "synthetic_only": true},
    "ai_gave_sources": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_SKIP"], "description_zh": "AI是否给出来源；无来源时依据处理为无相关输出", "synthetic_only": true},
    "ai_evidence_checked": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NO_RELEVANT_OUTPUT", "NA_DK", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NO_RELEVANT_OUTPUT", "NA_DK", "NA_MISS", "NA_SKIP"], "description_zh": "Q10：是否进行核查；将没有可核查输出与未核查分开", "synthetic_only": true},
    "ai_evidence_objects": {"type": "string", "nullable": false, "description_zh": "Q10：核查对象的多选类别编码；仅核查时记录", "synthetic_only": true},
    "ai_evidence_methods": {"type": "string", "nullable": false, "description_zh": "Q10：核查方式的多选类别编码；仅核查时记录", "synthetic_only": true},
    "ai_output_handling": {"type": "string", "nullable": false, "description_zh": "AI输出处理方式", "synthetic_only": true},
    "ai_disagreement_response": {"type": "string", "nullable": false, "description_zh": "意见冲突处理", "synthetic_only": true},
    "ai_method_compare": {"type": "string", "nullable": false, "description_zh": "是否要求方法比较", "synthetic_only": true},
    "method_choice_occurred": {"type": "string", "nullable": false, "enum": ["YES", "NO", "NA_DK", "NA_MISS", "NA_SKIP"], "allowed_values": ["YES", "NO", "NA_DK", "NA_MISS", "NA_SKIP"], "description_zh": "最近任务是否出现方法选择环节", "synthetic_only": true},
    "method_decision_actions": {"type": "string", "nullable": false, "description_zh": "Q14：本人理解、适配和选择方法的行为类别；与要求AI比较方法分开", "synthetic_only": true},
    "info_source_check_actions": {"type": "string", "nullable": false, "description_zh": "Q13：一般信息判断多选行为；无相关经历、未知、拒答、漏答分开", "synthetic_only": true},
    "a9_first_action": {"type": "string", "nullable": false, "description_zh": "A9情境先行策略", "synthetic_only": true},
    "a9_reason": {"type": "string", "nullable": false, "description_zh": "A9策略理由；仅模拟文本", "synthetic_only": true},
    "recent_task_type": {"type": "string", "nullable": false, "enum": ["COURSE_RESEARCH", "COURSE_SURVEY_REPORT", "INNOVATION_PROJECT", "COMPETITION_RESEARCH", "MENTOR_PROJECT", "OTHER_RESEARCH_TASK", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "allowed_values": ["COURSE_RESEARCH", "COURSE_SURVEY_REPORT", "INNOVATION_PROJECT", "COMPETITION_RESEARCH", "MENTOR_PROJECT", "OTHER_RESEARCH_TASK", "NA_DK", "NA_REFUSE", "NA_MISS", "NA_SKIP"], "description_zh": "Q2：最近任务类型；未知、拒答、漏答分开；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "task_participation_stages": {"type": "string", "nullable": false, "description_zh": "Q3：最近任务实际参与环节，以竖线分隔模拟多选类别；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "method_training": {"type": "string", "nullable": false, "description_zh": "研究方法训练背景", "synthetic_only": true},
    "major_group": {"type": "string", "nullable": false, "enum": ["ECONOMICS", "PUBLIC_FINANCE", "FINANCE_INSURANCE", "STATISTICS_DATA", "ACCOUNTING_AUDIT", "BUSINESS_MANAGEMENT", "TRADE_LOGISTICS", "OTHER_FINANCE_RELATED", "NA_DK", "NA_REFUSE"], "allowed_values": ["ECONOMICS", "PUBLIC_FINANCE", "FINANCE_INSURANCE", "STATISTICS_DATA", "ACCOUNTING_AUDIT", "BUSINESS_MANAGEMENT", "TRADE_LOGISTICS", "OTHER_FINANCE_RELATED", "NA_DK", "NA_REFUSE"], "description_zh": "Q4财经专业大类候选，分类边界仍待导师核定", "synthetic_only": true},
    "year_of_study": {"type": "string", "nullable": false, "description_zh": "年级", "synthetic_only": true},
    "school_type": {"type": "string", "nullable": false, "description_zh": "学校类型粗分类", "synthetic_only": true},
    "guidance_context": {"type": "string", "nullable": false, "description_zh": "近期任务中的主要支持来源；Q1非YES时为NA_SKIP", "synthetic_only": true},
    "training_need": {"type": "string", "nullable": false, "description_zh": "Q16：研究训练与培养需求；适用于所有候选回答者，不随Q1跳题", "synthetic_only": true},
    "unverified_acceptance": {"type": "string", "nullable": false, "description_zh": "未核验采纳行为自报", "synthetic_only": true},
    "info_confidence_optional": {"type": "string", "nullable": false, "description_zh": "OPTIONAL：信息判断自我感知，不作能力分数", "synthetic_only": true}
  },
  "additionalProperties": true
}
